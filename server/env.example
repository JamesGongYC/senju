# Copy to .env.server in the project folder (it is git-ignored) and fill in.
# Supabase dashboard > Settings > API Keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_...). Safe to send to browsers.
SUPABASE_PUBLISHABLE_KEY=...
# The secret key (sb_secret_...). Server only. Never commit it.
SUPABASE_SECRET_KEY=...
# Encrypts people's Anthropic keys in the database. Generate once: openssl rand -hex 32
# Keep it forever: changing it makes every stored key unreadable.
KEY_ENCRYPTION_SECRET=...
PORT=8787
